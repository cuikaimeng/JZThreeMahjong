# 生产环境后端配置模板（backend/.env）
# 部署脚本 deploy/server-setup.sh 会自动生成同样内容并写入服务器；此文件供手工部署参考。
PORT=3000

# PostgreSQL：仅本机访问，不在安全组放行 5432
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=mahjong
PG_PASSWORD=替换为强密码
PG_DATABASE=mahjong

# Redis：仅本机监听，不要配置 requirepass（后端暂无密码配置项）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 微信小游戏 AppID / Secret（留空走游客登录）
WX_APPID=
WX_SECRET=

# 跨域白名单，逗号分隔。微信小游戏不受 CORS 限制；
# 若只允许浏览器预览页访问，可填 https://预览域名，否则保持 *
CORS_ORIGINS=*

TOKEN_TTL_DAYS=7
